# Application
APP_NAME="Project Hermes"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Data Directories
DATA_DIR=./data
OSM_CACHE_DIR=./data/osm
ELEVATION_CACHE_DIR=./data/elevation
GRAPH_CACHE_DIR=./data/graphs

# Routing Configuration
DEFAULT_FITNESS_LEVEL=moderate
DEFAULT_PACK_WEIGHT_KG=12
DEFAULT_HOURS_PER_DAY=7
MAX_ROUTE_DISTANCE_KM=100

# OSM Configuration
OSM_USER_AGENT="project_hermes_hiking_planner"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Cache Configuration
ENABLE_GRAPH_CACHE=true
CACHE_EXPIRY_HOURS=24
