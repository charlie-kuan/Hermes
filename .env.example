# Application Settings
APP_NAME=Project Hermes
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Data Directories
DATA_DIR=./data
OSM_CACHE_DIR=./data/osm
ELEVATION_CACHE_DIR=./data/elevation
GRAPH_CACHE_DIR=./data/graphs

# Local DEM Configuration (Taiwan)
LOCAL_DEM_DIR=./data/elevation/dem
USE_LOCAL_DEM=True

# Routing Configuration
DEFAULT_FITNESS_LEVEL=moderate
DEFAULT_PACK_WEIGHT_KG=12.0
DEFAULT_HOURS_PER_DAY=7.0
MAX_ROUTE_DISTANCE_KM=100.0

# OSM Configuration
OSM_USER_AGENT=project_hermes_hiking_planner

# POI Download Settings (Recommended: False for Taiwan due to low OSM coverage)
# Setting to False can save 2-3 minutes per area download
OSM_DOWNLOAD_POIS=False

# POI Tags to download (only used if OSM_DOWNLOAD_POIS=True)
# Format: comma-separated key=value pairs
# Examples: natural=peak, tourism=alpine_hut, amenity=shelter
OSM_POI_TAGS=natural=peak

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
